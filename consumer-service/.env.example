NODE_ENV=development
SERVICE_NAME=finify_service_consumer
IS_CRD_PLAIN=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=finify_dev
DB_SSL=false
# Optional overrides for encrypted legacy credentials.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_IV=

KAFKA_CLIENT_ID=finify-service-consumer
KAFKA_GROUP_ID=finify-service-consumer
KAFKA_BROKERS=localhost:9092
# The producer publishes to the transaction keyword topic. Add every topic to read.
KAFKA_TOPICS=PMNT
KAFKA_FROM_BEGINNING=false

# Merchant types routed through reserve -> third-party confirmation -> settlement.
SPECIAL_MERCHANT_TYPES=Special,External

# HTTP API + Swagger (/docs and /docs-json)
CONSUMER_HTTP_PORT=5003
# At least 32 characters. Use a unique secret in every non-local environment.
INTEGRATION_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
# Required automatically when NODE_ENV=production; may also be enabled in development.
INTEGRATION_ADMIN_API_KEY=
# Public URL included in Kafka messages so the merchant processor can confirm/reject.
MERCHANT_CONFIRMATION_PUBLIC_URL=https://finify.example.com/v1/merchant-confirmations

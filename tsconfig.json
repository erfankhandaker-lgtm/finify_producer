{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,

    "esModuleInterop": true,
    "paths": {
      "@helpers/*": [
        "./src/helpers/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@models/*": [
        "./src/models/*"
      ]
    }
  },
  "exclude": [
    "admin-ui",
    "portal-ui",
    "accounting-service",
    "consumer-service",
    "credit-rule-service",
    "kyc-service",
    "kyc-ocr-service",
    "mock-merchant-service",
    "node_modules",
    "dist"
  ]
}

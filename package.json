{
  "name": "finify-service-producer",
  "version": "0.0.1",
  "description": "Finify service producer API built with NestJS, Kafka, Redis, and TypeORM.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:gateway": "node scripts/verify-gateway.js",
    "test:transaction-security": "jest --runInBand src/modules/transaction/transaction-security-regression.spec.ts src/modules/transaction/transaction-request.service.spec.ts src/modules/transaction/aml-transaction.service.spec.ts src/modules/transaction/password.service.spec.ts src/helpers/session-cookie.spec.ts",
    "migrate": "node scripts/migrate.js",
    "kyc:backfill-cases": "node scripts/backfill-customer-kyc-cases.js",
    "test:transaction-e2e": "node scripts/run-transaction-e2e.js",
    "test:onboarding-e2e": "node scripts/run-onboarding-runtime-e2e.js",
    "test:onboarding-channel-e2e": "node scripts/run-onboarding-channel-e2e.js",
    "test:onboarding-verified-e2e": "node scripts/run-onboarding-verified-runtime-e2e.js",
    "postman:generate": "node scripts/generate-postman-collection.js",
    "postman:validate": "node scripts/validate-postman-collection.js",
    "postman:onboarding": "node scripts/generate-onboarding-postman.js",
    "postman:onboarding:validate": "node scripts/validate-onboarding-postman.js",
    "admin:create": "ts-node -r tsconfig-paths/register scripts/create-admin.ts"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "i18n-2": "^0.7.3",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.7",
    "nest-winston": "^1.10.2",
    "nestjs-redis": "^1.3.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^20.0.0",
    "typeorm": "^1.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@helpers/(.*)$": "<rootDir>/helpers/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^@models/(.*)$": "<rootDir>/models/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

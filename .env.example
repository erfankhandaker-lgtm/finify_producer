TZ=Europe/London
# Use development on a laptop. Both prod and production activate production safeguards.
NODE_MODE=development
NODE_ENV=development
PORT=5002
KONG_IMAGE=kong:3.9.3
KONG_PROXY_HTTP_PORT=8080
KONG_PROXY_HTTPS_PORT=8444
PUBLIC_API_URL=http://localhost:8080/finify
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3200
ADMIN_UI_PORT=3100
PORTAL_UI_PORT=3200
SERVICE_NAME=finify_service_producer
IS_CRD_PLAIN=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_DIALECT=postgres
DB_NAME_TEST=finify_test
DB_NAME_DEVELOPMENT=finify_dev
DB_NAME_PRODUCTION=finify_prod
# Required by `npm run migrate` when IS_CRD_PLAIN is false.
MIGRATION_DATABASE_URL=
DB_USE_UTC=false
DB_TIMEZONE=+06:00
JWTKEY=your_jwt_secret
TOKEN_EXPIRATION=48h
ADMIN_JWT_SECRET=use_a_separate_random_secret_for_admin_sessions
ADMIN_SETUP_TOKEN=use_a_one_time_random_setup_token
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=replace_with_minio_access_key
MINIO_ROOT_PASSWORD=replace_with_a_long_random_minio_secret
MINIO_TREASURY_BUCKET=finify-treasury-documents
MINIO_ADMIN_BIOMETRIC_BUCKET=finify-admin-biometric
ADMIN_FACE_MATCH_THRESHOLD=45
BEARER=Bearer
SSL=false
SSL_KEY_PASSPHRASE=
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=finify_service_producer
KAFKA_CONSUMER_TOPIC=PMNTReply
KAFKA_PRODUCER_TOPIC=PMNT
REDIS_USERNAME=
REDIS_PASS=
REDIS_HOST=localhost
REDIS_PORT=6379
EMAIL=you@example.com
EMAIL_PASS=your_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
MOCK_MERCHANT_PORT=5010
MOCK_MERCHANT_TIMEOUT_DELAY_MS=5000
KYC_ADMIN_API_KEY=replace-with-a-long-random-kyc-service-key
ACCOUNTING_ADMIN_API_KEY=replace-with-a-long-random-accounting-service-key
INTEGRATION_ADMIN_API_KEY=replace-with-a-long-random-integration-service-key
INTEGRATION_SECRET_KEY=replace-with-a-32-byte-or-longer-integration-encryption-key
CREDIT_RULE_ADMIN_API_KEY=replace-with-a-long-random-credit-admin-key
CREDIT_RULE_EVALUATION_API_KEY=replace-with-a-long-random-credit-evaluation-key

# Mr. Finify (server-side only; never expose this key in NEXT_PUBLIC variables)
OPENAI_API_KEY=
# Mandatory in production for encrypting write-only secrets saved through Configuration.
FINIFY_SECRET_ENCRYPTION_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_MS=60000
MR_FINIFY_RATE_LIMIT_PER_MINUTE=20
KYC_PORT=5006
KYC_OCR_PORT=8000
MINIO_KYC_BUCKET=finify-kyc-documents
ONBOARDING_HANDOFF_SIGNING_KEY=
ONBOARDING_OTP_HMAC_KEY=
ONBOARDING_OTP_DEV_EXPOSE=false
ONBOARDING_CALLBACK_KEY=
KYC_SERVICE_URL=http://kyc:5006

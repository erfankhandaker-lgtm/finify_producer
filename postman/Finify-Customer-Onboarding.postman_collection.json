            "body": {
              "mode": "raw",
              "raw": "{\n  \"nodeKey\": \"{{currentNodeKey}}\",\n  \"outcome\": \"SUCCESS\",\n  \"output\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",

      "description": "Negative checks. Run deliberately after the matching progression request.",
      "item": [
        {
          "name": "Reject reused key with changed input",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "onboarding-{{$guid}}",
                "type": "text",
                "description": "Client-generated trace identifier. Use a new value for each logical operation."
              },
              {
                "key": "X-Onboarding-Resume-Token",
                "value": "{{onboardingResumeToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{lastStepIdempotencyKey}}",
                "type": "text"
              }

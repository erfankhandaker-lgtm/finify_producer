                "key": "X-Onboarding-Resume-Token",
                "value": "{{onboardingResumeToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "otp-send-{{$guid}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/onboarding/instances/{{onboardingInstanceId}}/otp/challenges",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
